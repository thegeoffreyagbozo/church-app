# ─── Secrets & environment (ADR 0006) ────────────────────────────────────────
# Only public keys ever live in clients; these files hold them per-environment and
# must never be committed. config/example.json IS committed as documentation.
config/dev.json
config/prod.json
config/*.local.json
.env
.env.*
!.env.example
!*.example.json

# ─── Per-church configs & branding (ADR 0007) ─────────────────────────────────
# Real church identity, backend config, and branding stay on the build machine only.
# Only the placeholder template (and a README) are committed.
churches/*
!churches/example/
!churches/README.md

# ─── Dart / Flutter ───────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
# NOTE: pubspec.lock IS committed (this is an application) for reproducible builds.
coverage/
*.lcov

# Generated code is regenerated by build_runner; keep it OUT of git unless CI minutes
# force otherwise (see ADR 0001 / README). Flip these if you decide to commit generated files.
*.g.dart
*.freezed.dart
*.config.dart

# ─── Android ──────────────────────────────────────────────────────────────────
apps/mobile/android/.gradle/
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/
apps/mobile/android/key.properties
apps/mobile/android/**/*.keystore
apps/mobile/android/**/*.jks
*.keystore
*.jks

# ─── iOS / macOS ──────────────────────────────────────────────────────────────
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/**/*.p8
apps/mobile/ios/**/*.p12
apps/mobile/ios/**/*.mobileprovision
*.p8
*.p12

# ─── Node / React admin ───────────────────────────────────────────────────────
node_modules/
admin/dist/
admin/.vite/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ─── Supabase ─────────────────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env

# Firebase / FCM service account (ADR 0006 — secret, never committed)
**/google-services.json
**/GoogleService-Info.plist
**/service-account*.json

# ─── Editors / OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
*.swp
.claude/
