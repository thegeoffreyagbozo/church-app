# Edge Function secrets (ADR 0006). Copy to supabase/.env (git-ignored) for local dev;
# push to the project with:  supabase secrets set --env-file supabase/.env
#
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into the Edge Function runtime — do NOT set them here.

# ── Paystack (giving slice — v1.3.0) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_signing_secret

# ── Cloudflare R2 (media slice — v1.2.0) ──────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=church-media

# ── Firebase Cloud Messaging (notifications slice — v1.5.0) ───────────────────
# Paste the service-account JSON as a single-line string, or mount a file path.
FCM_SERVICE_ACCOUNT_JSON=
